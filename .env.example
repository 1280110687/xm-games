# Copy this file to .env.local for local Redis integration testing.
# Never commit real URLs, tokens, or TURN credentials.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional, comma-separated public STUN/TURN URLs used by the browser.
# NEXT_PUBLIC_LAN_ICE_SERVERS=stun:stun.example.com:3478
