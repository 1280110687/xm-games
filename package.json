{
  "name": "xm-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:theme-four && next build",
    "build:theme-four": "pnpm --filter @xm-games/theme-four-experience build && pnpm --filter @xm-games/elemental-arena build && node scripts/sync-theme-four-build.mjs && node scripts/generate-offline-assets.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy -- --keep-vars",
    "cf:upload": "opennextjs-cloudflare upload -- --keep-vars",
    "cf:preview": "pnpm run cf:build && opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@upstash/redis": "^1.38.1",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "next": "16.2.11",
    "pixi.js": "8.19.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/dom-speech-recognition": "0.0.12",
    "@types/node": "^22",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  }
}
